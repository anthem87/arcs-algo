module

public import ArcsAlgo.Classical.FunctionalEquation
set_option autoImplicit false

/-!
# Theorem S at `q = 14` (paper §4.3)

For `a` coprime to 14, the characters of the arc `a/14` are the two non-trivial cubic characters
mod 14 (`arcChars14_eq`): `(ℤ/14)^*` is cyclic of order 6 generated by 3, the odd characters drop out
(`charCoeff_arcWeight_of_odd`) and the even non-trivial ones are cubic. `6 Re A_χ = 2L(1) − L(3) − L(5)`
with `L(r) = log|cos(π r a/14)|` (`re_charCoeff14`), and this is non-zero (`D14_ne_zero`) by the
ordering `cos(5π/14) < 1/2 < cos²(3π/14)`, `cos(5π/14) < cos(3π/14) < cos(π/14)`. So `A_χ/Ā_χ` is not
real negative, and every zero of `L(s, χ)` gives `Σ_χ A_χ ord_ρ L(s, χ) ≠ 0` (`thmS14_data`).
Theorem S follows (`thmS14_sign_changes`, `thmS14_not_eventually_upper`, `thmS14_not_eventually_lower`)
under the two certified inputs `R14` and `CubicZero14`.
-/

open Finset DirichletCharacter

@[expose] public section

namespace ArcsAlgo.Classical

/-- Every unit mod 14 is a power of 3. -/
theorem units14_pow3 (u : (ZMod 14)ˣ) :
    (u : ZMod 14) = 1 ∨ (u : ZMod 14) = 3 ∨ (u : ZMod 14) = 3 ^ 2 ∨ (u : ZMod 14) = 3 ^ 3 ∨
      (u : ZMod 14) = 3 ^ 4 ∨ (u : ZMod 14) = 3 ^ 5 := by
  have h : ∀ x : ZMod 14, IsUnit x → x = 1 ∨ x = 3 ∨ x = 3 ^ 2 ∨ x = 3 ^ 3 ∨ x = 3 ^ 4 ∨ x = 3 ^ 5 := by
    decide
  exact h _ u.isUnit

/-- A Dirichlet character mod 14 is determined by its value at 3. -/
theorem char14_ext {ψ φ : DirichletCharacter ℂ 14} (h : ψ 3 = φ 3) : ψ = φ := by
  refine MulChar.ext fun u => ?_
  rcases units14_pow3 u with h1 | h1 | h1 | h1 | h1 | h1 <;> rw [h1] <;> simp [map_pow, h]

/-- An even character mod 14 is cubic: every unit cubed is `±1`. -/
theorem char14_cube_of_even {ψ : DirichletCharacter ℂ 14} (h : ψ (-1) = 1) : ψ ^ 3 = 1 := by
  refine MulChar.ext fun u => ?_
  rw [MulChar.pow_apply_coe, MulChar.one_apply_coe, ← map_pow]
  have hc : ∀ x : ZMod 14, IsUnit x → x ^ 3 = 1 ∨ x ^ 3 = -1 := by decide
  rcases hc _ u.isUnit with h3 | h3 <;> rw [h3]
  · exact map_one ψ
  · exact h

/-- The values of a non-trivial cubic character mod 14: with `z = χ(3)`, `z³ = 1` and `z ≠ 1`. -/
theorem cubic14_z {χ : DirichletCharacter ℂ 14} (h3 : χ ^ 3 = 1) (h1 : χ ≠ 1) :
    χ 3 ^ 3 = 1 ∧ χ 3 ≠ 1 := by
  have hu : IsUnit (3 : ZMod 14) := by decide
  refine ⟨?_, fun hz => h1 (char14_ext (by rw [hz, MulChar.one_apply hu]))⟩
  have : (χ ^ 3) 3 = (1 : DirichletCharacter ℂ 14) 3 := by rw [h3]
  rwa [MulChar.pow_apply' χ (by norm_num), MulChar.one_apply hu] at this

theorem re_of_cube_root {z : ℂ} (h3 : z ^ 3 = 1) (h1 : z ≠ 1) : z.re = -1 / 2 ∧ (z ^ 2).re = -1 / 2 := by
  have hq : z ^ 2 + z + 1 = 0 := by
    have : (z - 1) * (z ^ 2 + z + 1) = 0 := by ring_nf; rw [h3]; ring
    exact (mul_eq_zero.1 this).resolve_left (sub_ne_zero.2 h1)
  have hre := congrArg Complex.re hq
  have him := congrArg Complex.im hq
  simp [sq, Complex.mul_re, Complex.mul_im] at hre him
  have hx : z.re = -1 / 2 := by
    rcases mul_eq_zero.1 (show z.im * (2 * z.re + 1) = 0 by linarith) with hy | hx
    · rw [hy] at hre; nlinarith [sq_nonneg (z.re + 1 / 2)]
    · linarith
  refine ⟨hx, ?_⟩
  have : z ^ 2 = -1 - z := by linear_combination hq
  rw [this]; simp [hx]; norm_num

/-- The characters of the arc `a/14` are cubic and non-trivial. -/
theorem arcChars14_cube {a : ℕ} {ψ : DirichletCharacter ℂ 14} (hψ : ψ ∈ arcChars (arcWeight 14 a)) :
    ψ ^ 3 = 1 ∧ ψ ≠ 1 := by
  classical
  unfold arcChars at hψ
  obtain ⟨-, h1, h2⟩ := Finset.mem_filter.1 hψ
  refine ⟨?_, h1⟩
  rcases ψ.even_or_odd with h | h
  · exact char14_cube_of_even h
  · exact absurd (charCoeff_arcWeight_of_odd a h) h2

theorem unitsZMod14 : unitsZMod 14 = {1, 3, 5, 9, 11, 13} := by decide

/-- `6 Re A_χ = 2L(1) − L(3) − L(5)` for a non-trivial cubic `χ` mod 14, `L(r) = log|cos(π r a/14)|`. -/
theorem re_charCoeff14 {χ : DirichletCharacter ℂ 14} (h3 : χ ^ 3 = 1) (h1 : χ ≠ 1) (a : ℕ) :
    6 * (charCoeff (arcWeight 14 a) χ).re =
      2 * logCos 14 a 1 - logCos 14 a 3 - logCos 14 a 5 := by
  obtain ⟨hz3, hz1⟩ := cubic14_z h3 h1
  obtain ⟨hre1, hre2⟩ := re_of_cube_root hz3 hz1
  set z := χ 3
  have v1 : χ 1 = 1 := map_one χ
  have v9 : χ 9 = z ^ 2 := by rw [show (9 : ZMod 14) = 3 ^ 2 by decide, map_pow]
  have v13 : χ 13 = 1 := by rw [show (13 : ZMod 14) = 3 ^ 3 by decide, map_pow, hz3]
  have v11 : χ 11 = z := by
    rw [show (11 : ZMod 14) = 3 ^ 3 * 3 by decide, map_mul, map_pow, hz3, one_mul]
  have v5 : χ 5 = z ^ 2 := by
    rw [show (5 : ZMod 14) = 3 ^ 3 * 3 ^ 2 by decide, map_mul, map_pow, map_pow, hz3, one_mul]
  have i1 : (1 : ZMod 14)⁻¹ = 1 := ZMod.inv_eq_of_mul_eq_one 14 _ _ (by decide)
  have i3 : (3 : ZMod 14)⁻¹ = 5 := ZMod.inv_eq_of_mul_eq_one 14 _ _ (by decide)
  have i5 : (5 : ZMod 14)⁻¹ = 3 := ZMod.inv_eq_of_mul_eq_one 14 _ _ (by decide)
  have i9 : (9 : ZMod 14)⁻¹ = 11 := ZMod.inv_eq_of_mul_eq_one 14 _ _ (by decide)
  have i11 : (11 : ZMod 14)⁻¹ = 9 := ZMod.inv_eq_of_mul_eq_one 14 _ _ (by decide)
  have i13 : (13 : ZMod 14)⁻¹ = 13 := ZMod.inv_eq_of_mul_eq_one 14 _ _ (by decide)
  have l13 : logCos 14 a 13 = logCos 14 a 1 := by
    rw [show (13 : ZMod 14) = -1 by decide, logCos_neg]
  have l11 : logCos 14 a 11 = logCos 14 a 3 := by
    rw [show (11 : ZMod 14) = -3 by decide, logCos_neg]
  have l9 : logCos 14 a 9 = logCos 14 a 5 := by
    rw [show (9 : ZMod 14) = -5 by decide, logCos_neg]
  have hφ : ((Nat.totient 14 : ℕ) : ℂ) = 6 := by
    rw [show Nat.totient 14 = 6 by decide]; norm_num
  unfold charCoeff
  rw [unitsZMod14, hφ]
  simp only [Finset.sum_insert (show (1 : ZMod 14) ∉ ({3, 5, 9, 11, 13} : Finset (ZMod 14)) by decide),
    Finset.sum_insert (show (3 : ZMod 14) ∉ ({5, 9, 11, 13} : Finset (ZMod 14)) by decide),
    Finset.sum_insert (show (5 : ZMod 14) ∉ ({9, 11, 13} : Finset (ZMod 14)) by decide),
    Finset.sum_insert (show (9 : ZMod 14) ∉ ({11, 13} : Finset (ZMod 14)) by decide),
    Finset.sum_insert (show (11 : ZMod 14) ∉ ({13} : Finset (ZMod 14)) by decide),
    Finset.sum_singleton, i1, i3, i5, i9, i11, i13, v1, v5, v9, v11, v13]
  simp only [Complex.mul_re, Complex.add_re, Complex.ofReal_re, Complex.ofReal_im, Complex.one_re,
    Complex.one_im, Complex.inv_re, Complex.inv_im, Complex.add_im, Complex.mul_im]
  rw [hre1, hre2]
  unfold arcWeight
  rw [l13, l11, l9]
  norm_num
  ring


section Cosines
open Real
/-- `|cos(π n/14)|` depends on `n mod 14`. -/
theorem abs_cos_mod14 (n : ℕ) : |cos (π * n / 14)| = |cos (π * ((n % 14 : ℕ) : ℝ) / 14)| := by
  have hn : (n : ℝ) = 14 * ((n / 14 : ℕ) : ℝ) + ((n % 14 : ℕ) : ℝ) := by
    exact_mod_cast (Nat.div_add_mod n 14).symm
  rw [hn, show π * (14 * ((n / 14 : ℕ) : ℝ) + ((n % 14 : ℕ) : ℝ)) / 14 =
    π * ((n % 14 : ℕ) : ℝ) / 14 + ((n / 14 : ℕ) : ℝ) * π by ring]
  rw [cos_add, cos_nat_mul_pi, sin_nat_mul_pi, mul_zero, sub_zero, abs_mul, abs_pow, abs_neg,
    abs_one, one_pow, mul_one]

theorem abs_cos_nat_mul_pi_sub (n : ℕ) (x : ℝ) : |cos (n * π - x)| = |cos x| := by
  rw [cos_sub, cos_nat_mul_pi, sin_nat_mul_pi, zero_mul, add_zero, abs_mul, abs_pow,
    abs_neg, abs_one, one_pow, one_mul]

theorem abs_cos_refl14 {v w : ℕ} (h : v + w = 14) :
    |cos (π * (w : ℝ) / 14)| = |cos (π * (v : ℝ) / 14)| := by
  have hw : (w : ℝ) = 14 - v := by
    have : (v : ℝ) + w = 14 := by exact_mod_cast h
    linarith
  rw [hw, show π * (14 - (v : ℝ)) / 14 = ((1 : ℕ) : ℝ) * π - π * v / 14 by push_cast; ring,
    abs_cos_nat_mul_pi_sub]

/-- `L(r) = log|cos(π v a/14)|` reduces to `v a mod 14`. -/
theorem logCos14_eq (a : ℕ) (r : ZMod 14) :
    logCos 14 a r = Real.log |cos (π * (((r.val * a) % 14 : ℕ) : ℝ) / 14)| := by
  unfold logCos
  rw [← abs_cos_mod14]; push_cast; ring_nf

theorem cos_pi14_facts :
    0 < cos (π * 5 / 14) ∧ cos (π * 5 / 14) < cos (π * 3 / 14) ∧ cos (π * 3 / 14) < cos (π * 1 / 14) ∧
      cos (π * 5 / 14) < 1 / 2 ∧ 1 / 2 < cos (π * 3 / 14) ^ 2 := by
  have hp := pi_pos
  refine ⟨cos_pos_of_mem_Ioo ⟨by linarith, by linarith⟩, ?_, ?_, ?_, ?_⟩
  · exact cos_lt_cos_of_nonneg_of_le_pi (by positivity) (by linarith) (by linarith)
  · exact cos_lt_cos_of_nonneg_of_le_pi (by positivity) (by linarith) (by linarith)
  · rw [← cos_pi_div_three]
    exact cos_lt_cos_of_nonneg_of_le_pi (by positivity) (by linarith) (by linarith)
  · have h : cos (π / 4) < cos (π * 3 / 14) :=
      cos_lt_cos_of_nonneg_of_le_pi (by positivity) (by linarith) (by linarith)
    rw [cos_pi_div_four] at h
    have hs : (√2 / 2) ^ 2 = 1 / 2 := by rw [div_pow, sq_sqrt (by norm_num)]; norm_num
    have h0 : 0 ≤ √2 / 2 := by positivity
    nlinarith

/-- `2 log x ≠ log y + log z` when `x² ≠ yz`, all positive. -/
theorem two_log_ne {x y z : ℝ} (hx : 0 < x) (hy : 0 < y) (hz : 0 < z) (h : x ^ 2 ≠ y * z) :
    2 * Real.log x - Real.log y - Real.log z ≠ 0 := by
  intro h0
  apply h
  have : Real.log (x ^ 2) = Real.log (y * z) := by
    rw [Real.log_pow, Real.log_mul hy.ne' hz.ne']; push_cast; linarith
  exact Real.log_injOn_pos (Set.mem_Ioi.2 (by positivity)) (Set.mem_Ioi.2 (by positivity)) this

/-- **The real part of `A_χ` does not vanish**: `2L(1) − L(3) − L(5) ≠ 0` for every `a` coprime to 14. -/
theorem D14_ne_zero {a : ℕ} (ha : a.Coprime 14) :
    2 * logCos 14 a 1 - logCos 14 a 3 - logCos 14 a 5 ≠ 0 := by
  obtain ⟨h5, h53, h31, h5h, h3h⟩ := cos_pi14_facts
  have h3 : 0 < cos (π * 3 / 14) := h5.trans h53
  have h1 : 0 < cos (π * 1 / 14) := h3.trans h31
  set c1 := cos (π * 1 / 14)
  set c3 := cos (π * 3 / 14)
  set c5 := cos (π * 5 / 14)
  have e1 : |cos (π * ((1 : ℕ) : ℝ) / 14)| = c1 := by push_cast; exact abs_of_pos h1
  have e3 : |cos (π * ((3 : ℕ) : ℝ) / 14)| = c3 := by push_cast; exact abs_of_pos h3
  have e5 : |cos (π * ((5 : ℕ) : ℝ) / 14)| = c5 := by push_cast; exact abs_of_pos h5
  have e9 : |cos (π * ((9 : ℕ) : ℝ) / 14)| = c5 := by
    rw [abs_cos_refl14 (v := 5) (by norm_num), e5]
  have e11 : |cos (π * ((11 : ℕ) : ℝ) / 14)| = c3 := by
    rw [abs_cos_refl14 (v := 3) (by norm_num), e3]
  have e13 : |cos (π * ((13 : ℕ) : ℝ) / 14)| = c1 := by
    rw [abs_cos_refl14 (v := 1) (by norm_num), e1]
  have v1 : (1 : ZMod 14).val = 1 := rfl
  have v3 : (3 : ZMod 14).val = 3 := rfl
  have v5 : (5 : ZMod 14).val = 5 := rfl
  rw [logCos14_eq, logCos14_eq, logCos14_eq, v1, v3, v5]
  have hm : a % 14 = 1 ∨ a % 14 = 3 ∨ a % 14 = 5 ∨ a % 14 = 9 ∨ a % 14 = 11 ∨ a % 14 = 13 := by
    have hc : Nat.Coprime (a % 14) 14 := by
      rw [Nat.Coprime, ← Nat.gcd_rec, Nat.gcd_comm]; exact ha
    have hlt : a % 14 < 14 := Nat.mod_lt _ (by norm_num)
    interval_cases h : a % 14 <;> simp_all (config := { decide := true })
  have r : ∀ v : ℕ, (v * a) % 14 = (v * (a % 14)) % 14 := fun v => by rw [Nat.mul_mod, Nat.mul_mod v (a % 14), Nat.mod_mod]
  rw [r 1, r 3, r 5]
  have hc1 : c1 ≤ 1 := cos_le_one _
  have hA : c1 ^ 2 ≠ c3 * c5 := by
    have := mul_lt_mul'' h31 (h53.trans h31) h3.le h5.le
    rw [sq]; exact ne_of_gt this
  have hB : c3 ^ 2 ≠ c5 * c1 := by
    have : c5 * c1 ≤ c5 := mul_le_of_le_one_right h5.le hc1
    exact ne_of_gt (by linarith)
  have hC : c5 ^ 2 ≠ c1 * c3 := by
    have := mul_lt_mul'' (h53.trans h31) h53 h5.le h5.le
    rw [sq]; exact ne_of_lt this
  rcases hm with h | h | h | h | h | h <;> rw [h] <;> simp only [Nat.reduceMul, Nat.reduceMod]
  · rw [e1, e3, e5]; exact two_log_ne h1 h3 h5 hA
  · rw [e3, e9, e1]; exact two_log_ne h3 h5 h1 hB
  · rw [e5, e1, e11]; exact two_log_ne h5 h1 h3 hC
  · rw [e9, e13, e3]; exact two_log_ne h5 h1 h3 hC
  · rw [e11, e5, e13]; exact two_log_ne h3 h5 h1 hB
  · rw [e13, e11, e9]; exact two_log_ne h1 h3 h5 hA

end Cosines

/-! ### The certified inputs and Theorem S at `q = 14` -/

/-- **Condition (R) at `q = 14`** (certified in Arb, `python/certification/certify_L_real_segment.py`,
for the cubic character mod 7; the cubic characters mod 14 are induced by it and the Euler factor
`1 − χ(2)2^{−σ}` does not vanish): `L(σ, χ) ≠ 0` for `σ ∈ [1/2, 1]` and the non-trivial cubic `χ` mod 14. -/
def R14 : Prop :=
  ∀ χ : DirichletCharacter ℂ 14, χ ^ 3 = 1 → χ ≠ 1 → ∀ σ : ℝ, 1 / 2 ≤ σ → σ ≤ 1 → LFunction χ σ ≠ 0

/-- **A zero on the critical line at `q = 14`** (certified in Arb,
`python/certification/certify_zero_cubic7.py`: the Hardy function of the cubic character mod 7
changes sign on `[4.35546875, 4.3564453125]`): some non-trivial cubic `χ` mod 14 has
`L(1/2 + it, χ) = 0` with `4.355 ≤ t ≤ 4.357`. -/
def CubicZero14 : Prop :=
  ∃ χ : DirichletCharacter ℂ 14, χ ^ 3 = 1 ∧ χ ≠ 1 ∧
    ∃ t : ℝ, 4355 / 1000 ≤ t ∧ t ≤ 4357 / 1000 ∧ LFunction χ (1 / 2 + t * Complex.I) = 0

theorem cube_roots_eq {z w : ℂ} (hz3 : z ^ 3 = 1) (hz1 : z ≠ 1) (hw3 : w ^ 3 = 1) (hw1 : w ≠ 1) :
    w = z ∨ w = z ^ 2 := by
  have q : ∀ x : ℂ, x ^ 3 = 1 → x ≠ 1 → x ^ 2 + x + 1 = 0 := fun x h3 h1 => by
    have : (x - 1) * (x ^ 2 + x + 1) = 0 := by ring_nf; rw [h3]; ring
    exact (mul_eq_zero.1 this).resolve_left (sub_ne_zero.2 h1)
  have hz := q z hz3 hz1
  have hw := q w hw3 hw1
  have : (w - z) * (w + z + 1) = 0 := by linear_combination hw - hz
  rcases mul_eq_zero.1 this with h | h
  · left; linear_combination h
  · right; linear_combination h - hz

open scoped _root_.Classical in
/-- **The characters of the arc `a/14`**: `X(a/14) = {χ, χ̄}`, the two non-trivial cubic characters. -/
theorem arcChars14_eq {a : ℕ} (ha : a.Coprime 14) {χ : DirichletCharacter ℂ 14} (h3 : χ ^ 3 = 1)
    (h1 : χ ≠ 1) : arcChars (arcWeight 14 a) = {χ, χ⁻¹} := by
  classical
  have hmem : χ ∈ arcChars (arcWeight 14 a) := by
    unfold arcChars
    refine Finset.mem_filter.2 ⟨Finset.mem_univ _, h1, fun h0 => ?_⟩
    have := re_charCoeff14 h3 h1 a
    rw [h0, Complex.zero_re, mul_zero] at this
    exact D14_ne_zero ha this.symm
  ext ψ
  simp only [Finset.mem_insert, Finset.mem_singleton]
  constructor
  · intro hψ
    obtain ⟨hψ3, hψ1⟩ := arcChars14_cube hψ
    obtain ⟨hz3, hz1⟩ := cubic14_z h3 h1
    obtain ⟨hw3, hw1⟩ := cubic14_z hψ3 hψ1
    rcases cube_roots_eq hz3 hz1 hw3 hw1 with h | h
    · exact Or.inl (char14_ext h)
    · right
      refine char14_ext ?_
      rw [h, MulChar.inv_apply_eq_inv']
      have hz0 : χ 3 ≠ 0 := fun h0 => by rw [h0] at hz3; norm_num at hz3
      field_simp
      linear_combination hz3
  · rintro (rfl | rfl)
    · exact hmem
    · exact arcChars_inv _ χ hmem

theorem char_ne_inv {χ : DirichletCharacter ℂ 14} (h3 : χ ^ 3 = 1) (h1 : χ ≠ 1) : χ ≠ χ⁻¹ := by
  intro h
  apply h1
  have h2 : χ ^ 2 = 1 := by rw [sq]; nth_rewrite 2 [h]; exact mul_inv_cancel χ
  calc χ = χ ^ 3 * (χ ^ 2)⁻¹ := by group
    _ = 1 := by rw [h3, h2]; simp

theorem order_pos14 {χ : DirichletCharacter ℂ 14} (h1 : χ ≠ 1) {ρ : ℂ} (hρ : LFunction χ ρ = 0) :
    1 ≤ analyticOrderNatAt (LFunction χ) ρ := by
  have hLan : AnalyticOnNhd ℂ (LFunction χ) Set.univ := fun s _ =>
    (differentiable_LFunction h1).analyticAt s
  have hfin : analyticOrderAt (LFunction χ) ρ ≠ ⊤ := by
    refine hLan.analyticOrderAt_ne_top_of_isPreconnected isPreconnected_univ (x := (2 : ℂ)) trivial
      trivial ?_
    rw [analyticOrderAt_eq_zero.2 (Or.inr (LFunction_ne_zero_of_one_le_re χ (Or.inl h1) (by norm_num)))]
    exact ENat.zero_ne_top
  rw [Nat.one_le_iff_ne_zero]
  intro h0
  have := Nat.cast_analyticOrderNatAt hfin
  rw [h0, Nat.cast_zero] at this
  rcases analyticOrderAt_eq_zero.1 this.symm with h | h
  · exact h (hLan ρ trivial)
  · exact h hρ

/-- The data of Theorem S at `q = 14`, from the two certified inputs. -/
theorem thmS14_data (hZ : CubicZero14) {a : ℕ} (ha : a.Coprime 14) :
    ∃ ρ₀ : ℂ, 1 / 2 ≤ ρ₀.re ∧
      ∑ χ ∈ arcChars (arcWeight 14 a), charCoeff (arcWeight 14 a) χ *
        (analyticOrderNatAt (LFunction χ) ρ₀ : ℂ) ≠ 0 := by
  obtain ⟨χ, h3, h1, t, -, -, hzero⟩ := hZ
  classical
  refine ⟨1 / 2 + t * Complex.I, by simp, ?_⟩
  rw [arcChars14_eq ha h3 h1, Finset.sum_pair (char_ne_inv h3 h1), charCoeff_inv]
  set A := charCoeff (arcWeight 14 a) χ
  set m₁ := analyticOrderNatAt (LFunction χ) (1 / 2 + t * Complex.I)
  set m₂ := analyticOrderNatAt (LFunction χ⁻¹) (1 / 2 + t * Complex.I)
  have hm₁ : 1 ≤ m₁ := order_pos14 h1 hzero
  have hA : A.re ≠ 0 := fun h0 => by
    have := re_charCoeff14 h3 h1 a
    rw [h0, mul_zero] at this
    exact D14_ne_zero ha this.symm
  intro hsum
  have hre := congrArg Complex.re hsum
  simp only [Complex.add_re, Complex.mul_re, Complex.natCast_re, Complex.natCast_im, mul_zero,
    sub_zero, Complex.conj_re, Complex.zero_re] at hre
  have : A.re * ((m₁ : ℝ) + m₂) = 0 := by linarith
  rcases mul_eq_zero.1 this with h | h
  · exact hA h
  · have : (1 : ℝ) ≤ m₁ := by exact_mod_cast hm₁
    have : (0 : ℝ) ≤ m₂ := Nat.cast_nonneg _
    linarith

theorem thmS14_inputs (hR : R14) (a : ℕ) :
    (∀ χ ∈ arcChars (arcWeight 14 a), χ ≠ 1) ∧ (∀ χ ∈ arcChars (arcWeight 14 a), χ⁻¹ ∈ arcChars (arcWeight 14 a)) ∧
      (∀ χ ∈ arcChars (arcWeight 14 a), χ ^ 2 ∈ arcChars (arcWeight 14 a)) ∧
      IsCharCombination (arcChars (arcWeight 14 a)) (charCoeff (arcWeight 14 a)) (unitWeight (arcWeight 14 a)) ∧
      ∀ χ ∈ arcChars (arcWeight 14 a), ∀ σ : ℝ, 1 / 2 ≤ σ → σ ≤ 1 → LFunction χ σ ≠ 0 := by
  refine ⟨fun χ hχ => (arcChars14_cube hχ).2, arcChars_inv _, fun χ hχ => ?_,
    isCharCombination_unitWeight _ (sum_arcWeight a), fun χ hχ => hR χ (arcChars14_cube hχ).1 (arcChars14_cube hχ).2⟩
  have h3 := (arcChars14_cube hχ).1
  have : χ ^ 2 = χ⁻¹ := by
    rw [eq_inv_iff_mul_eq_one, ← pow_succ, h3]
  rw [this]; exact arcChars_inv _ χ hχ

/-- **Theorem S** (paper §4.3): for every `a` coprime to 14, `H_{a/14}(N)` changes sign infinitely
often, under (R) at `q = 14` and the certified zero on the critical line. -/
theorem thmS14_sign_changes (hR : R14) (hZ : CubicZero14) {a : ℕ} (ha : a.Coprime 14) :
    (∀ x₀ : ℕ, ∃ N, x₀ ≤ N ∧ 0 < primeRace (unitWeight (arcWeight 14 a)) N) ∧
      (∀ x₀ : ℕ, ∃ N, x₀ ≤ N ∧ primeRace (unitWeight (arcWeight 14 a)) N < 0) := by
  obtain ⟨hX1, hXinv, hXsq, hc, hR'⟩ := thmS14_inputs hR a
  obtain ⟨ρ₀, hρ₀, hN₀⟩ := thmS14_data hZ ha
  exact thmS_sign_changes' _ hX1 hXinv hXsq _ _ hc hR' hρ₀ hN₀

/-- **Theorem S** (paper §4.3), `Ω₊`: `H_{a/14}(N) = Ω₊(N^θ)` for every `θ < 1/2`. -/
theorem thmS14_not_eventually_upper (hR : R14) (hZ : CubicZero14) {a : ℕ} (ha : a.Coprime 14)
    {θ : ℝ} (hθ : θ < 1 / 2) :
    ¬ ∃ (C : ℝ) (x₀ : ℕ), ∀ N : ℕ, x₀ ≤ N →
      primeRace (unitWeight (arcWeight 14 a)) N ≤ C * (N : ℝ) ^ θ := by
  obtain ⟨hX1, hXinv, hXsq, hc, hR'⟩ := thmS14_inputs hR a
  obtain ⟨ρ₀, hρ₀, hN₀⟩ := thmS14_data hZ ha
  exact thmS_not_eventually_upper' _ hX1 hXinv hXsq _ _ hc hR' hρ₀ hN₀ hθ

/-- **Theorem S** (paper §4.3), `Ω₋`: `H_{a/14}(N) = Ω₋(N^θ)` for every `θ < 1/2`. -/
theorem thmS14_not_eventually_lower (hR : R14) (hZ : CubicZero14) {a : ℕ} (ha : a.Coprime 14)
    {θ : ℝ} (hθ : θ < 1 / 2) :
    ¬ ∃ (C : ℝ) (x₀ : ℕ), ∀ N : ℕ, x₀ ≤ N →
      -(C * (N : ℝ) ^ θ) ≤ primeRace (unitWeight (arcWeight 14 a)) N := by
  obtain ⟨hX1, hXinv, hXsq, hc, hR'⟩ := thmS14_inputs hR a
  obtain ⟨ρ₀, hρ₀, hN₀⟩ := thmS14_data hZ ha
  exact thmS_not_eventually_lower' _ hX1 hXinv hXsq _ _ hc hR' hρ₀ hN₀ hθ

end ArcsAlgo.Classical
