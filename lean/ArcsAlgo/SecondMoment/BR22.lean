module

public import Mathlib.LinearAlgebra.Matrix.PosDef
public import Mathlib.Analysis.SpecialFunctions.Pow.Real
public import Mathlib.GroupTheory.Index
set_option autoImplicit false

/-!
# The local expansion for lattice vectors [BR, §22], as an explicit hypothesis

The general statement of [BR, Theorem 22.1] for bounded vectors of `ℤ^d`, with the first
correction term absorbed into the error, is the `Prop` `BR22`. It is a cited classical theorem and
enters every result that uses it as an explicit hypothesis; it is never an `axiom`. The
definitions it needs are here: the law of `X₁ + … + X_n` (`lawPow`), the mean (`vmean`), the
covariance (`vcov`), the minimal lattice (`minLat`) and the Gaussian density (`gaussDens`).

[BR] R. N. Bhattacharya, R. Ranga Rao, *Normal Approximation and Asymptotic Expansions*, Wiley
(1976); reprinted SIAM Classics in Applied Mathematics 64 (2010).
-/

open Finset Matrix

@[expose] public section

namespace ArcsAlgo.LLT

/-- A law on `ℤ^d` given by a finite parameter space: `X = ξ(ω)` with `Pr(ω = a) = p a`. -/
noncomputable def lawPow {Ω : Type} [Fintype Ω] {d : ℕ} (p : Ω → ℝ) (ξ : Ω → Fin d → ℤ) (n : ℕ)
    (x : Fin d → ℤ) : ℝ :=
  ∑ ω : Fin n → Ω, if ∑ i, ξ (ω i) = x then ∏ i, p (ω i) else 0

noncomputable def vmean {Ω : Type} [Fintype Ω] {d : ℕ} (p : Ω → ℝ) (ξ : Ω → Fin d → ℤ) :
    Fin d → ℝ :=
  fun j => ∑ a, p a * (ξ a j : ℝ)

noncomputable def vcov {Ω : Type} [Fintype Ω] {d : ℕ} (p : Ω → ℝ) (ξ : Ω → Fin d → ℤ) :
    Matrix (Fin d) (Fin d) ℝ :=
  fun j k => ∑ a, p a * ((ξ a j : ℝ) - vmean p ξ j) * ((ξ a k : ℝ) - vmean p ξ k)

/-- The minimal lattice: the subgroup generated by the differences of the support points. -/
def minLat {Ω : Type} {d : ℕ} (p : Ω → ℝ) (ξ : Ω → Fin d → ℤ) : AddSubgroup (Fin d → ℤ) :=
  AddSubgroup.closure {v | ∃ a b, 0 < p a ∧ 0 < p b ∧ v = ξ a - ξ b}

/-- The centred Gaussian density with covariance `V` on `ℝ^d`. -/
noncomputable def gaussDens {d : ℕ} (V : Matrix (Fin d) (Fin d) ℝ) (y : Fin d → ℝ) : ℝ :=
  Real.exp (-(1 / 2) * (y ⬝ᵥ (V⁻¹ *ᵥ y))) / (√(2 * Real.pi) ^ d * √V.det)

/-- **The local expansion for sums of independent lattice vectors** [BR, Theorem 22.1], in the case
of bounded vectors and with the first correction term absorbed into the error.

R. N. Bhattacharya, R. Ranga Rao, *Normal Approximation and Asymptotic Expansions*, Wiley (1976),
§22, Theorem 22.1 (with `s = 3`: all moments of a bounded vector are finite). Let `X₁, X₂, …` be
independent copies of a random vector `X` of `ℤ^d` with finite support, covariance `V` non-singular,
mean `μ`, and minimal lattice `L` (`X ∈ x₀ + L` almost surely). Then, uniformly in
`x ∈ n x₀ + L`,
`Pr(X₁ + … + X_n = x) = det(L) n^{−d/2} φ_V((x − nμ)/√n) + O(n^{−(d+1)/2})`,
where `det(L)` is the index of `L` in `ℤ^d`. Theorem 22.1 gives the expansion up to
`o(n^{−(d+1)/2})` with the term `n^{−d/2−1/2} q₁`, and `q₁` is a polynomial times `φ_V`, so it is
bounded. This is a cited classical theorem, used as an explicit hypothesis. -/
def BR22 : Prop :=
  ∀ (Ω : Type) [Fintype Ω] (d : ℕ) (p : Ω → ℝ) (ξ : Ω → Fin d → ℤ),
    (∀ a, 0 ≤ p a) → ∑ a, p a = 1 → (vcov p ξ).PosDef → ∀ a₀, 0 < p a₀ →
    ∃ C : ℝ, ∀ n : ℕ, 1 ≤ n → ∀ x : Fin d → ℤ, x - n • ξ a₀ ∈ minLat p ξ →
      |lawPow p ξ n x - ((minLat p ξ).index : ℝ) *
          gaussDens (vcov p ξ) (fun j => ((x j : ℝ) - n * vmean p ξ j) / √n) / √n ^ d|
        ≤ C / √n ^ (d + 1)

end ArcsAlgo.LLT
